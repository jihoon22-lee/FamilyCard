// FamilyCard — Prisma 스키마
//
// 설계 근거: docs/design/01-data-model.md
// 이 파일을 고칠 때는 반드시 그 문서를 먼저 읽으세요.
//
// 핵심 원칙 (문서에서 그대로 가져옴):
//   "원문(RawMessage)은 사실이고, 거래(Transaction)는 해석이다."
//   금액은 전부 Int(원 단위 정수). Float/Decimal 금지.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7부터 datasource.url을 schema.prisma에 직접 쓰는 것을 더 이상
  // 지원하지 않습니다(P1012). 연결 문자열은 prisma.config.ts에서 공급합니다.
  // 자세한 내용은 web/prisma.config.ts와 이 웨이브의 보고서를 참고하세요.
}

// ─────────────────────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────────────────────

enum FamilyRole {
  MEMBER
  ADMIN
}

enum CardType {
  CREDIT
  DEBIT
}

enum CardAliasType {
  MASKED_DIGITS
  NICKNAME
  RAW_TOKEN
}

enum MessageSource {
  NOTIFICATION
  SMS
  MANUAL
  STATEMENT
}

enum ParseStatus {
  PENDING
  PARSED
  NEEDS_CARD
  FAILED
  IGNORED
}

enum TransactionType {
  APPROVAL
  CANCELLATION
}

enum BenefitPeriodType {
  PREV_CALENDAR_MONTH
  STATEMENT_CYCLE
}

enum CancellationPolicy {
  DEDUCT_FROM_ORIGINAL
  DEDUCT_FROM_CANCEL_PERIOD
}

// ─────────────────────────────────────────────────────────────
// FamilyMember — 가족 구성원.
// role은 실제로는 Phase 5에서 쓰이지만 스키마에는 Phase 1부터 넣는다
// (문서 지시: 나중에 얹으면 이미 작성된 모든 쿼리를 다시 뒤져야 함).
// ─────────────────────────────────────────────────────────────

model FamilyMember {
  id           String     @id @default(cuid())
  name         String
  role         FamilyRole @default(MEMBER)
  // 가족 대시보드 차트에서 구성원 구분용.
  displayColor String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices      Device[]
  cards        Card[]
  transactions Transaction[]
  budgets      Budget[]
}

// ─────────────────────────────────────────────────────────────
// Device — 앱이 설치된 기기 1대 = 1 레코드.
// 이 프로젝트에서 가장 중요한 조인 키 (memberId를 확정시킴 → 카드 매칭 후보를
// "그 사람의 카드"로 좁혀준다).
// ─────────────────────────────────────────────────────────────

model Device {
  id         String   @id @default(cuid())
  memberId   String
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deviceName String
  // 토큰 원문은 저장하지 않는다. 발급 시 1회만 화면에 표시.
  tokenHash  String   @unique
  // 수집기 무응답 감지용(Phase 6). 아직 한 번도 통신하지 않은 신규 기기는 null.
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawMessages RawMessage[]
}

// ─────────────────────────────────────────────────────────────
// Card — 카드 한 장. 집계와 실적의 기본 단위.
// ─────────────────────────────────────────────────────────────

model Card {
  id       String   @id @default(cuid())
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // 정규화된 카드사 코드 (SHINHAN, KB, SAMSUNG, ...)
  issuer   String
  // 사용자가 붙인 이름. 카드사가 별칭만 보낼 때 매칭에도 사용(4단계 매칭).
  nickname String
  // 정답값. 사용자가 카드 등록 시 직접 입력 (알림에서 추측하지 않음).
  last4    String
  cardType CardType
  // 실적 사이클이 STATEMENT_CYCLE일 때 사용하는 결제일.
  statementDay Int
  // 해지한 카드는 삭제하지 않고 isActive=false로. 과거 거래는 유지.
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases      CardAlias[]
  transactions Transaction[]
  benefitRule  CardBenefitRule?

  // 카드 매칭 2단계: (memberId, issuer, last4) 정확 일치 조회.
  @@unique([memberId, issuer, last4])
}

// ─────────────────────────────────────────────────────────────
// CardAlias — 알림에 실제로 찍히는 카드 표기의 변형을 학습해 두는 캐시.
// 미확정 큐에서 사람이 카드를 지정하면 자동 생성된다.
// ─────────────────────────────────────────────────────────────

model CardAlias {
  id        String        @id @default(cuid())
  cardId    String
  card      Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  aliasType CardAliasType
  // 알림에 실제로 찍힌 문자열 그대로 (정규화하지 않음).
  token     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 카드 매칭 1단계 — 가장 먼저, 가장 싸게 조회됨.
  @@index([token])
}

// ─────────────────────────────────────────────────────────────
// RawMessage — 절대 삭제하지 않는 테이블. 수집한 알림·문자 원문.
// (AGENTS.md 불변 규칙 1)
// ─────────────────────────────────────────────────────────────

model RawMessage {
  id          String        @id @default(cuid())
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  source      MessageSource
  // 알림을 띄운 앱의 패키지명. SMS면 발신번호.
  packageName String
  title       String
  // 원문. 파싱 실패해도 여기 남아 있다.
  body        String
  // 캡처 시각 (업로드 시각이 아님 — 오프라인 큐 때문에 며칠 차이날 수 있음).
  receivedAt  DateTime
  // 멱등 수집의 핵심. 없으면 앱의 재전송 정책이 중복 적재로 이어진다.
  dedupeHash  String        @unique
  parseStatus ParseStatus   @default(PENDING)
  // 어느 규칙으로 파싱됐는지 추적. PENDING/FAILED/IGNORED 상태면 null일 수 있음.
  parserRuleId String?
  parserRule   ParserRule?  @relation(fields: [parserRuleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction?

  // 미확정 큐 조회 — 상태로 걸러 최신순 정렬.
  @@index([parseStatus, receivedAt])
  // 기기별 최근 수집 확인.
  @@index([deviceId, receivedAt])
}

// ─────────────────────────────────────────────────────────────
// ParserRule — 카드사별 파싱 규칙. 코드가 아니라 데이터라서 배포 없이
// 웹 UI에서 고친다.
// ─────────────────────────────────────────────────────────────

model ParserRule {
  id             String   @id @default(cuid())
  issuer         String
  // 이 규칙을 적용할지 판정하는 정규식 (예: ^\[?신한카드).
  matchPattern   String
  // 명명 그룹으로 필드를 뽑는 정규식.
  extractPattern String
  // 명명 그룹 → 필드 매핑, 변환 방식(금액 콤마 제거 등).
  fieldMap       Json
  // 낮을수록 먼저 적용. 첫 매치 채택.
  priority       Int
  isActive       Boolean  @default(true)
  // 이 규칙이 대상으로 하는 문구 예시. 가공된 샘플만 (AGENTS.md 불변 규칙 7).
  sampleText     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawMessages RawMessage[]
}

// ─────────────────────────────────────────────────────────────
// Transaction — 파싱된 거래. 원문에서 재생성 가능한 파생 테이블.
//
// netAmount(= amount - canceledAmount)는 저장 컬럼이 아니라 계산값이다.
// 모든 집계는 애플리케이션 레벨에서 이 값을 계산해서 써야 한다
// (AGENTS.md 불변 규칙 5). 여기에 컬럼으로 넣지 않는다.
// ─────────────────────────────────────────────────────────────

model Transaction {
  id           String     @id @default(cuid())
  // 원문 1건 = 거래 1건. 재파싱 시 upsert 키.
  rawMessageId String     @unique
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id], onDelete: Restrict)

  // 카드 매칭 전이면 null (미확정 큐).
  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  // 원 단위 정수. 부동소수점 금지.
  amount         Int
  // 취소 누적액. 부분취소가 여러 번이어도 정확해야 한다.
  canceledAmount Int             @default(0)
  txType         TransactionType

  // 취소 건(txType=CANCELLATION)이 가리키는 원거래.
  canceledTxId        String?
  canceledTransaction Transaction?  @relation("TransactionCancellation", fields: [canceledTxId], references: [id], onDelete: SetNull)
  // 원거래 입장에서, 자신을 취소한 거래들 (역방향).
  cancellations        Transaction[] @relation("TransactionCancellation")

  // 원거래를 못 찾은 취소 (앱 설치 전 결제, 60일 초과 등).
  isOrphanCancellation Boolean  @default(false)

  approvedAt   DateTime
  merchantName String
  // 0 = 일시불.
  installmentMonths Int    @default(0)
  // 해외 결제. 원화 환산액은 amount에 들어간다.
  currency      String @default("KRW")
  foreignAmount Int?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // 실적 제외 사유. null이면 실적에 포함.
  excludeReason String?
  // true면 재파싱이 이 거래를 덮어쓰지 않는다 (사람의 판단이 우선).
  isManuallyEdited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 거의 모든 조회의 기본 패턴 — scope 필터(memberId in [...]) + 기간.
  @@index([memberId, approvedAt])
  // 카드별 집계·실적 산정.
  @@index([cardId, approvedAt])
  // 취소 원거래 탐색 — 카드+금액+기간으로 후보를 좁힘. 없으면 풀스캔.
  @@index([cardId, amount, approvedAt])
}

// ─────────────────────────────────────────────────────────────
// CardBenefitRule — 카드별 실적 규칙. 카드 1장당 최대 1개.
// ─────────────────────────────────────────────────────────────

model CardBenefitRule {
  id     String @id @default(cuid())
  cardId String @unique
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // PREV_CALENDAR_MONTH(전월 1일~말일) | STATEMENT_CYCLE(결제일 기준)
  periodType BenefitPeriodType

  // [{ threshold: 300000, benefitDesc: "...", monthlyCap: 10000 }, ...]
  tiers Json
  // ["TAX", "GIFT_CARD", "APT_FEE", ...]
  exclusions Json
  // 건별 최소 인정 금액 (예: 1만원 미만 미인정).
  minPerTxAmount Int @default(0)
  // 취소를 어느 사이클에서 뺄지.
  cancellationPolicy CancellationPolicy @default(DEDUCT_FROM_ORIGINAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Category / MerchantRule — 가맹점명 → 카테고리 자동 분류.
// 실적 제외 판정에도 쓰인다 (예: "세금·공과금"은 대부분 실적 제외 대상).
// ─────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(cuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  merchantRules MerchantRule[]
  budgets       Budget[]
}

model MerchantRule {
  id         String   @id @default(cuid())
  // 가맹점명에 대조할 패턴.
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // priority 순으로 적용.
  priority   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Budget — 월별 예산. memberId·categoryId가 모두 nullable이라
// (있음/없음) 네 가지 조합으로 "개인 카테고리 예산" ~ "가족 전체 예산"까지
// 표현한다.
// ─────────────────────────────────────────────────────────────

model Budget {
  id         String   @id @default(cuid())
  memberId   String?
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // YYYY-MM
  month  String
  amount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
