{
  "name": "@familycard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:security": "pnpm audit --audit-level=high",
    "audit:security:prod": "pnpm audit --prod --audit-level=high",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.31.0",
    "next": "15.5.24",
    "next-auth": "5.0.0-beta.32",
    "pdfkit": "0.20.2",
    "re2js": "2.8.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "postcss": "^8.5.26",
      "sharp": "^0.35.4",
      "mysql2": "^3.23.1",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
