# ═══════════════════════════════════════════════════════════════════
# FamilyCard 환경 변수
#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# ⚠️  .env 는 절대 커밋하지 마세요. (.gitignore 에 등록되어 있음)
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 데이터베이스
# ─────────────────────────────────────────────────────────────
# 로컬 개발: docker-compose.yml 의 postgres 서비스를 가리킴
# NAS 배포:  docker-compose.prod.yml 내부 네트워크 호스트명 사용
POSTGRES_USER=familycard
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=familycard

DATABASE_URL=postgresql://familycard:change-me-to-a-long-random-string@localhost:5432/familycard?schema=public

# ─────────────────────────────────────────────────────────────
# 인증
# ─────────────────────────────────────────────────────────────
# Auth.js 세션 서명 키. 아래 명령으로 생성:
#   openssl rand -base64 32
AUTH_SECRET=

# 앱이 접근하는 서버 주소.
# 로컬 개발:  http://localhost:3000
# NAS 배포:   https://familycard.<your-tailnet>.ts.net
#   └ 안드로이드 앱 설정 탭에 입력하는 주소와 반드시 동일해야 합니다.
#     (WebView 가 이 호스트 외의 URL 로드를 차단하기 때문)
APP_URL=http://localhost:3000
AUTH_URL=${APP_URL}

# 가족 계정 최초 가입 시 요구하는 초대 코드.
# 이 코드를 아는 사람만 계정을 만들 수 있습니다. 가족에게만 알려주세요.
INVITE_CODE=change-me

# ─────────────────────────────────────────────────────────────
# 디바이스 세션 (안드로이드 앱 → WebView 자동 로그인)
# ─────────────────────────────────────────────────────────────
# 디바이스 토큰을 세션으로 교환할 때 쓰는 일회용 nonce 의 유효 시간(초).
# 짧을수록 안전합니다. 기본 60초.
DEVICE_SESSION_NONCE_TTL=60

# ─────────────────────────────────────────────────────────────
# 수집 파이프라인
# ─────────────────────────────────────────────────────────────
# /api/ingest 가 한 번에 받는 최대 메시지 개수.
# 앱의 오프라인 큐가 밀렸다가 한꺼번에 올라올 때를 대비한 상한.
INGEST_MAX_BATCH_SIZE=200

# 수집기 무응답 경고 기준(일). 이 기간 동안 데이터를 안 보낸 기기를 경고 표시.
# (Phase 6)
DEVICE_SILENCE_WARN_DAYS=3

# ─────────────────────────────────────────────────────────────
# 취소 매칭
# ─────────────────────────────────────────────────────────────
# 취소 알림이 들어왔을 때 원거래를 거슬러 찾는 최대 기간(일).
# 이 기간을 벗어나면 '고아 취소'로 처리됩니다.
CANCELLATION_LOOKBACK_DAYS=60

# ─────────────────────────────────────────────────────────────
# 로깅
# ─────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ⚠️  운영 환경에서 debug 로 두지 마세요.
#    파싱 디버그 로그에 카드 알림 원문(가맹점·금액)이 남습니다.
