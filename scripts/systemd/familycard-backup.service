[Unit]
Description=FamilyCard private PostgreSQL backup

[Service]
Type=oneshot
WorkingDirectory=%h/projects/FamilyCard
EnvironmentFile=-%h/projects/FamilyCard/data/secrets/backup-offsite.env
ExecStart=/usr/bin/python3 %h/projects/FamilyCard/scripts/backup-database.py
ExecStartPost=/usr/bin/python3 %h/projects/FamilyCard/scripts/backup-retention.py
TimeoutStartSec=40min
UMask=0077
NoNewPrivileges=true
